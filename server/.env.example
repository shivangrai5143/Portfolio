# GitHub Token (required — create at github.com/settings/tokens)
# Scope needed: public_repo (read-only) for classic tokens
# OR: no extra scopes needed for fine-grained tokens (just "Public Repositories" read)
GITHUB_TOKEN=ghp_your_token_here

# Your GitHub username
GITHUB_USERNAME=shivangrai5143

# Port for the Express server
PORT=3001

# Comma-separated allowed frontend origins (for CORS)
# Add your Vercel URL after deploying: https://shivang-2005.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
