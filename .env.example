# ─── Firebase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ─── GitHub ───────────────────────────────────────────────────────────────────
# Personal access token — needs: repo (read), user (read)
GITHUB_TOKEN=
NEXT_PUBLIC_GITHUB_USERNAME=shivangrai5143

# ─── Cloudinary ───────────────────────────────────────────────────────────────
# Find these at: https://console.cloudinary.com/settings/api-keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Resend (Email Notifications) ────────────────────────────────────────────
# Get your API key at: https://resend.com/api-keys
RESEND_API_KEY=

# Email address to receive contact form notifications
CONTACT_EMAIL=your@email.com

# ─── Site Config ─────────────────────────────────────────────────────────────
# Used for Open Graph, sitemap, and email links back to admin
NEXT_PUBLIC_SITE_URL=https://your-portfolio.vercel.app
